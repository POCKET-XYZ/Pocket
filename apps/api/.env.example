# Server
PORT=3000
# Public address of the API, with the /api prefix, used in links it hands out
# (for example the CV link). Optional locally.
API_PUBLIC_URL=
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3001

# Database (Supabase: Project Settings > Database > Connection string)
# Pooled connection used by the app (transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Direct connection used by Prisma Migrate (port 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Auth
# At least 32 random characters: openssl rand -base64 48. The API refuses to
# start with a short one or with this placeholder.
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Stellar: testnet | mainnet
STELLAR_NETWORK=testnet
# Optional: defaults to the public Horizon of the network above
HORIZON_URL=
# Soroban RPC node escrows are read from. Optional on testnet (SDF's public
# node); required on mainnet, from an RPC provider.
SOROBAN_RPC_URL=

# Internal team: comma-separated Stellar addresses seeded as managers
MANAGER_STELLAR_ADDRESSES=

# Trustless Work (escrow). Testnet during development.
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=
# What every platform signature is checked against. Read them from a real
# deploy and a real release on the network you use (see docs/security.md):
# the platform key refuses anything that does not match.
# Testnet values:
TRUSTLESS_WORK_DEPLOYER_CONTRACT_ID=CAZZOSFFNQQSDOLPPGN5BDITMNSLZITXW4S7V5ISM5EAB2THBD7F2AHR
TRUSTLESS_WORK_FEE_ADDRESS=GA6KH5VWPCHBOEF63X57SPX6T4H366YFFKKGCVDBTXT2N7JVL6PJCK7G
# Hash of the escrow code Trustless Work deploys (the second argument of a real
# deploy). An escrow running other code is never used.
TRUSTLESS_WORK_ESCROW_WASM_HASH=5618791548edfc44074e4b79e5d1b29f5712ff98eead12d22fb4d7f04d4edbf2
# Testnet USDC issuer
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Platform account that signs the escrow deploy and platform-role operations.
# Its address is derived from the secret.
STELLAR_PLATFORM_SECRET=

# Pollar (wallets and logins for users without a Stellar wallet of their own).
# Optional: without the secret key Pocket only accepts wallet sign-ins.
# Dashboard > Build > API Keys, the sec_testnet_ / sec_mainnet_ one.
POLLAR_SECRET_KEY=
# Optional: defaults to https://server.api.pollar.xyz
POLLAR_SERVER_URL=

# Security monitoring (see docs/security.md)
# Where alerts go: a Slack or Discord incoming webhook. Set it in production.
SECURITY_ALERT_WEBHOOK_URL=
# XLM left for fees under which the platform account raises an alert
PLATFORM_MIN_XLM=20
# Proxies in front of the API: 0 locally, 1 behind Railway or Render
TRUST_PROXY_HOPS=0
