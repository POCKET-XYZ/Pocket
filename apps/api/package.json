{
  "name": "@pocket/api",
  "version": "0.0.0",
  "private": true,
  "description": "Pocket REST API (NestJS + Prisma)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "db:seed": "prisma db seed",
    "stellar:setup": "bun scripts/setup-platform.ts",
    "stellar:cosigner": "bun scripts/platform-cosigner.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11",
    "@pocket/shared": "workspace:*",
    "@prisma/client": "^6",
    "@stellar/stellar-sdk": "^17.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@types/express": "^5.0.6",
    "@types/jest": "^30",
    "@types/node": "^24",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30",
    "prisma": "^6",
    "ts-jest": "^29",
    "typescript-eslint": "^8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!.*(uint8array-extras|@noble|@exodus))"
    ]
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  }
}
