// Pocket relational data model (off-chain state).
// Enum values mirror @pocket/shared and are stored as-is: never rename one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase pooled connection (Supavisor, port 6543) used by the app.
  url       = env("DATABASE_URL")
  // Supabase direct connection (port 5432) used by Prisma Migrate.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserRole {
  startup
  specialist
  manager
}

enum VerificationStatus {
  not_submitted
  pending
  approved
  rejected
}

// Who holds the key of the wallet, which decides what it can sign.
enum WalletCustody {
  // A wallet the user holds themselves (Freighter, xBull, Lobstr...). It signs
  // any transaction, escrow operations included.
  external
  // A wallet that only signs through Pollar: the ones Pollar keeps for social
  // and email logins, and passkey smart accounts. They pay and receive, but
  // they cannot sign an escrow operation.
  pollar
}

// A user IS their Stellar wallet: they sign in by signing a challenge with it
// or through Pollar, and the same address takes their role in every escrow
// they join.
model User {
  id                 String             @id @default(uuid()) @db.Uuid
  stellarAddress     String             @unique @map("stellar_address")
  role               UserRole
  verificationStatus VerificationStatus @default(not_submitted) @map("verification_status")
  walletCustody      WalletCustody      @default(external) @map("wallet_custody")
  // Which wallet or login created the address: freighter, google, email...
  walletProvider     String?            @map("wallet_provider")
  // Pollar's own user id, when the account was created through Pollar.
  pollarUserId       String?            @unique @map("pollar_user_id")
  // Email Pollar verified during login. Empty for wallet sign-ins.
  email              String?
  // When Pocket asked Pollar to put the XLM reserve on the wallet.
  walletFundedAt     DateTime?          @map("wallet_funded_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  verificationRequests  VerificationRequest[] @relation("VerificationRequests")
  verificationsReviewed VerificationRequest[] @relation("VerificationReviews")
  startupProfile        StartupProfile?
  specialistProfile     SpecialistProfile?
  jobs                  Job[]
  applications          Application[]
  contractsAsStartup    Contract[]            @relation("ContractStartup")
  contractsAsSpecialist Contract[]            @relation("ContractSpecialist")
  disputesOpened        Dispute[]             @relation("DisputeOpenedBy")
  disputesResolved      Dispute[]             @relation("DisputeResolvedBy")
  disputeEvidence       DisputeEvidence[]
  chainOperations       ChainOperation[]

  @@map("users")
}

// One outstanding SEP-10 style login challenge per address. The row is replaced
// on every new challenge and deleted once a login succeeds.
model AuthChallenge {
  id             String   @id @default(uuid()) @db.Uuid
  stellarAddress String   @unique @map("stellar_address")
  nonce          String
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("auth_challenges")
}

// ---------------------------------------------------------------------------
// Verification (manual KYC/KYB reviewed by a manager)
// ---------------------------------------------------------------------------

// One request per submission. A user keeps their history: the newest row is the
// one that decides their current verification status.
model VerificationRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  status                VerificationStatus @default(pending)
  fullName              String             @map("full_name")
  contactEmail          String             @map("contact_email")
  // ISO 3166-1 alpha-2 country code.
  country               String             @db.Char(2)
  linkedinUrl           String?            @map("linkedin_url")
  websiteUrl            String?            @map("website_url")
  // Startups only.
  companyName           String?            @map("company_name")
  companyRegistrationId String?            @map("company_registration_id")
  note                  String?
  // Filled in by the manager who reviewed it.
  reviewNote            String?            @map("review_note")
  reviewedById          String?            @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime?          @map("reviewed_at")
  submittedAt           DateTime           @default(now()) @map("submitted_at")

  user       User  @relation("VerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviews", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}

// ---------------------------------------------------------------------------
// Standardized profiles
// ---------------------------------------------------------------------------

enum StartupStage {
  idea
  pre_seed
  seed
  series_a
  series_b_plus
}

enum ServiceCategory {
  growth
  sales
  marketing
  digital_marketing
}

// Fixed template every startup fills in, so profiles stay comparable.
model StartupProfile {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @unique @map("user_id") @db.Uuid
  companyName String       @map("company_name")
  // One sentence describing what the company does.
  oneLiner    String       @map("one_liner")
  sector      String
  stage       StartupStage
  // What they need help with right now.
  lookingFor  String       @map("looking_for")
  websiteUrl  String?      @map("website_url")
  logoUrl     String?      @map("logo_url")
  // Registered name, when it differs from the trading name.
  legalName   String?      @map("legal_name")
  // Role of the person who signs the contracts.
  contactRole String?      @map("contact_role")
  languages   String[]     @default([])
  location    String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("startup_profiles")
}

// Fixed template every specialist fills in. Rates are in USDC.
model SpecialistProfile {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @unique @map("user_id") @db.Uuid
  displayName      String            @map("display_name")
  // Short professional headline, e.g. "B2B SaaS outbound specialist".
  headline         String
  bio              String
  categories       ServiceCategory[]
  skills           String[]          @default([])
  // Past work the startup can check: [{ url, result }], where result is
  // the outcome in one line, e.g. "+40% followers in 2 months".
  caseStudies      Json              @default("[]") @map("case_studies")
  // Tools they work with, e.g. Meta Ads, GA4, HubSpot.
  tools            String[]          @default([])
  yearsExperience  Int?              @map("years_experience")
  // Languages they work in, and where they are, for startups in other countries.
  languages        String[]          @default([])
  timezone         String?
  // Hours a week they can take on.
  weeklyHours      Int?              @map("weekly_hours")
  hourlyRate       Decimal?          @map("hourly_rate") @db.Decimal(20, 7)
  minProjectBudget Decimal?          @map("min_project_budget") @db.Decimal(20, 7)
  portfolioUrl     String?           @map("portfolio_url")
  linkedinUrl      String?           @map("linkedin_url")
  avatarUrl        String?           @map("avatar_url")
  location         String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categories])
  @@map("specialist_profiles")
}

// ---------------------------------------------------------------------------
// Jobs and applications
// ---------------------------------------------------------------------------

enum JobStatus {
  open
  in_progress
  completed
  closed
}

enum ApplicationStatus {
  submitted
  accepted
  rejected
  withdrawn
}

// A piece of work a startup posts for specialists to apply to. Budget is in USDC.
model Job {
  id              String          @id @default(uuid()) @db.Uuid
  startupId       String          @map("startup_id") @db.Uuid
  title           String
  description     String
  category        ServiceCategory
  // What the startup expects to receive at the end.
  deliverables    String
  budget          Decimal         @db.Decimal(20, 7)
  deadline        DateTime        @db.Date
  // How many rounds of changes the price includes.
  revisionRounds  Int             @default(1) @map("revision_rounds")
  // Where the work is published or used, e.g. TikTok, LinkedIn, a landing page.
  channel         String?
  // Language of the content itself, not of the conversation.
  contentLanguage String?         @map("content_language")
  // What the startup hands over: script, brand, logo, access to the app.
  startupProvides String?         @map("startup_provides")
  status          JobStatus       @default(open)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  startup      User           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  applications Application[]
  contracts    Contract[]
  milestones   JobMilestone[]

  @@index([status, category])
  @@index([startupId])
  @@map("jobs")
}

// The payment plan the startup posts with the job: what has to be delivered,
// what it has to meet to be approved, how much it pays and when. It is copied
// into the contract when hiring, adjusted only if the two sides negotiated.
model JobMilestone {
  id                 String   @id @default(uuid()) @db.Uuid
  jobId              String   @map("job_id") @db.Uuid
  position           Int
  title              String
  description        String
  // What it has to meet for the startup to approve it.
  acceptanceCriteria String   @map("acceptance_criteria")
  amount             Decimal  @db.Decimal(20, 7)
  dueDate            DateTime @map("due_date") @db.Date

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, position])
  @@map("job_milestones")
}

// A specialist's offer on a job. One per specialist and job; the price may
// differ from the posted budget.
model Application {
  id               String            @id @default(uuid()) @db.Uuid
  jobId            String            @map("job_id") @db.Uuid
  specialistId     String            @map("specialist_id") @db.Uuid
  // How they would do it.
  approach         String
  // A piece of past work close to this job.
  similarWorkUrl   String?           @map("similar_work_url")
  // What they need from the startup to start.
  needsFromStartup String?           @map("needs_from_startup")
  price            Decimal           @db.Decimal(20, 7)
  // Days from the moment the escrow is funded.
  estimatedDays    Int               @map("estimated_days")
  status           ApplicationStatus @default(submitted)
  decidedAt        DateTime?         @map("decided_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  specialist User      @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  contract   Contract?

  @@unique([jobId, specialistId])
  @@index([specialistId])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// Contracts, milestones and deliverables
// ---------------------------------------------------------------------------

enum ContractStatus {
  awaiting_specialist
  awaiting_funding
  active
  completed
  cancelled
}

enum MilestoneStatus {
  pending
  delivered
  changes_requested
  approved
  paid
  disputed
  resolved
}

// The agreement between a startup and the specialist it chose. Each contract
// gets its own multi-release escrow on Stellar, one release per milestone.
model Contract {
  id            String         @id @default(uuid()) @db.Uuid
  jobId         String         @map("job_id") @db.Uuid
  applicationId String         @unique @map("application_id") @db.Uuid
  startupId     String         @map("startup_id") @db.Uuid
  specialistId  String         @map("specialist_id") @db.Uuid
  // USDC. Always equals the sum of the milestones.
  amount        Decimal        @db.Decimal(20, 7)
  status        ContractStatus @default(awaiting_specialist)
  // Soroban contract id (C...) of the Trustless Work escrow, once deployed.
  escrowId      String?        @unique @map("escrow_id")
  acceptedAt    DateTime?      @map("accepted_at")
  fundedAt      DateTime?      @map("funded_at")
  completedAt   DateTime?      @map("completed_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startup         User             @relation("ContractStartup", fields: [startupId], references: [id], onDelete: Cascade)
  specialist      User             @relation("ContractSpecialist", fields: [specialistId], references: [id], onDelete: Cascade)
  milestones      Milestone[]
  chainOperations ChainOperation[]

  @@index([jobId])
  @@index([startupId])
  @@index([specialistId])
  @@map("contracts")
}

model Milestone {
  id                 String          @id @default(uuid()) @db.Uuid
  contractId         String          @map("contract_id") @db.Uuid
  // Zero-based index of this milestone inside the escrow.
  position           Int
  title              String
  description        String
  // What it has to meet to be approved, carried over from the job.
  acceptanceCriteria String?         @map("acceptance_criteria")
  // USDC.
  amount             Decimal         @db.Decimal(20, 7)
  dueDate            DateTime        @map("due_date") @db.Date
  status             MilestoneStatus @default(pending)
  // Rounds of changes already asked for on this milestone.
  revisionsUsed      Int             @default(0) @map("revisions_used")
  approvedAt         DateTime?       @map("approved_at")
  paidAt             DateTime?       @map("paid_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  contract        Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliverables    Deliverable[]
  disputes        Dispute[]
  chainOperations ChainOperation[]

  @@unique([contractId, position])
  @@map("milestones")
}

// One submission of a milestone's work. Every version is kept.
model Deliverable {
  id          String   @id @default(uuid()) @db.Uuid
  milestoneId String   @map("milestone_id") @db.Uuid
  version     Int
  url         String
  note        String?
  // Set when the startup asks for changes on this version.
  feedback    String?
  createdAt   DateTime @default(now()) @map("created_at")

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, version])
  @@map("deliverables")
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------

enum DisputeStatus {
  open
  resolved
}

enum DisputeOutcome {
  pay_specialist
  refund_startup
  split
}

model Dispute {
  id               String          @id @default(uuid()) @db.Uuid
  milestoneId      String          @map("milestone_id") @db.Uuid
  openedById       String          @map("opened_by") @db.Uuid
  reason           String
  status           DisputeStatus   @default(open)
  outcome          DisputeOutcome?
  // USDC each side receives, set when a manager resolves it.
  specialistAmount Decimal?        @map("specialist_amount") @db.Decimal(20, 7)
  startupAmount    Decimal?        @map("startup_amount") @db.Decimal(20, 7)
  resolutionNote   String?         @map("resolution_note")
  resolvedById     String?         @map("resolved_by") @db.Uuid
  resolvedAt       DateTime?       @map("resolved_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  milestone  Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  openedBy   User              @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy User?             @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  evidence   DisputeEvidence[]

  @@index([milestoneId])
  @@index([status])
  @@map("disputes")
}

model DisputeEvidence {
  id        String   @id @default(uuid()) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  url       String?
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_evidence")
}

// ---------------------------------------------------------------------------
// On-chain operations
// ---------------------------------------------------------------------------

enum ChainOperationKind {
  trustline
  deploy
  fund
  approve
  release
  dispute
  resolve
}

enum ChainOperationStatus {
  prepared
  confirmed
  failed
}

// Every Stellar transaction Pocket builds or sends. A transaction a user has to
// sign is stored as `prepared` with its hash; only a signed transaction with
// that same hash is accepted back, so the API never relays anything it did not
// build for that user and that purpose.
model ChainOperation {
  id          String               @id @default(uuid()) @db.Uuid
  kind        ChainOperationKind
  status      ChainOperationStatus @default(prepared)
  // Hash of the transaction, hex. Signatures do not change it.
  txHash      String               @unique @map("tx_hash")
  // Who has to sign it; null when the platform signs.
  signerId    String?              @map("signer_id") @db.Uuid
  contractId  String?              @map("contract_id") @db.Uuid
  milestoneId String?              @map("milestone_id") @db.Uuid
  // USDC moved by this operation, when it moves any.
  amount      Decimal?             @db.Decimal(20, 7)
  // Set while the operation is confirmed, to "<kind>:<contract or milestone id>".
  // Unique, so each escrow step happens once per contract (deploy, fund) or per
  // milestone (approve, release, dispute, resolve), even with parallel requests.
  // Cleared when the operation fails so the step can be retried. Null for
  // trustlines, which are not tied to a contract.
  stepKey     String?              @unique @map("step_key")
  error       String?
  createdAt   DateTime             @default(now()) @map("created_at")
  confirmedAt DateTime?            @map("confirmed_at")

  signer    User?      @relation(fields: [signerId], references: [id], onDelete: SetNull)
  contract  Contract?  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([milestoneId])
  @@map("chain_operations")
}
