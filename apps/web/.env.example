# Pocket API, including the /api prefix
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Stellar network the wallets sign for: testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Pollar publishable key (Dashboard > Build > API Keys, the pub_ one).
# Optional: without it the app only offers wallet sign-in.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
